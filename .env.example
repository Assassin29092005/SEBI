# LLM provider keys — OPTIONAL. The demo, tests, and every user-facing
# feature run without any key configured (every LLM path has a deterministic
# fallback; see README.md "The whole system runs without any API key").
#
# Set one to enable the optional LLM enrichments: chattier examiner,
# LLM-assisted prose extraction from uploads, richer generated section prose
# (still gated by the digit-level hallucination guard).
GEMINI_API_KEY=
GROQ_API_KEY=

# Provider preference: "gemini" | "groq". Client picks the first configured
# provider — no key on either → LLMUnavailable → deterministic path.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Backend bind
API_HOST=127.0.0.1
API_PORT=8000

# Auth (see backend/app/auth). JWT_SECRET_KEY is REQUIRED for a real
# deployment — leave it unset only for local/demo use, where the app falls
# back to a random per-process key (every restart invalidates all sessions).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_EXPIRY_MINUTES=480

# Auditor / merchant-banker registration requires the matching invite code
# below (blank disables that role's self-registration entirely). Promoter
# registration is always open — an SME signing itself up is the primary path.
BANKER_INVITE_CODE=
AUDITOR_INVITE_CODE=

# Security: max size (bytes) of any request body, checked up front via
# Content-Length for every endpoint and enforced again by a bounded read loop
# for file uploads specifically (see backend/app/main.py). Default 20 MB is
# generous for a scanned SME filing PDF while still bounding memory/CPU use
# against an oversized or malicious upload.
MAX_REQUEST_BODY_BYTES=20971520

# Encryption at rest (see backend/app/crypto.py). Protects the session
# snapshot (issuer financials, PAN/CIN, litigation records), the user store,
# and archived original uploads. REQUIRED for real use — unset, the app
# falls back to a per-process random key (fine for local dev; everything
# encrypted becomes unreadable on the next restart). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Litigation lookup — OPTIONAL, real API (see backend/app/intake/litigation.py).
# "indiankanoon" connects to api.indiankanoon.org, a real paid service
# (~Rs 0.50/search page; signup at api.indiankanoon.org/signup/ gets Rs 500
# free trial credit; verified non-commercial use can get a Rs 10,000/month
# free allowance). It indexes PUBLISHED judgments only — Supreme Court, High
# Court, tribunals — not a live pending-case docket (no free public API over
# Indian courts' live case status exists; this is a real, documented gap,
# not something this connector hides). Blank provider or missing token keeps
# the app on the offline mock (canned demo records) with zero behavior
# change to callers.
LITIGATION_PROVIDER=
INDIANKANOON_API_TOKEN=
INDIANKANOON_MAX_RESULTS=10

# OCR for scanned/photographed documents (see backend/app/intake/ocr.py).
# Real SME paperwork often has no digital text layer at all — a phone photo
# of a certificate, a flatbed scan. Requires Tesseract OCR installed as a
# SYSTEM BINARY on the machine running the backend (not a pip package):
#   Windows: choco install tesseract  (or the installer from
#            github.com/UB-Mannheim/tesseract/wiki)
#   Debian/Ubuntu: apt install tesseract-ocr
#   macOS: brew install tesseract
# Leave TESSERACT_CMD blank if `tesseract` is already on PATH; set it to the
# full binary path otherwise (common on Windows, where the installer doesn't
# add it to PATH automatically — typically
# "C:\Program Files\Tesseract-OCR\tesseract.exe"). Without a working
# Tesseract install, scanned pages/images extract no facts — extraction
# never crashes, it just has nothing to find on those pages, same as an
# empty page today.
TESSERACT_CMD=
TESSERACT_LANG=eng

# Backup & disaster recovery (see backend/app/backup.py,
# backend/scripts/backup_data.py, backend/scripts/restore_data.py). Periodic
# full backups: a plain-SQL pg_dump of Postgres plus the archived-uploads and
# audit-log directories, bundled into one timestamped .tar.gz. Requires the
# Postgres client tools (pg_dump/psql) as system binaries — they ship with
# any PostgreSQL server/client install (see docker-compose.yml's postgres
# image, or install postgresql-client locally) but pip only installs the
# async driver, not these CLI tools. Set PG_DUMP_CMD/PSQL_CMD to the full
# binary path if they aren't on PATH (e.g. on Windows:
# "C:\Program Files\PostgreSQL\18\bin\pg_dump.exe"). Nothing runs this on a
# schedule automatically — this app has no scheduler of its own; run
# backend/scripts/backup_data.py from cron / Windows Task Scheduler for a
# real cadence. BACKUP_RETENTION_COUNT=0 disables pruning old backups.
# (BACKUP_DIR is a filesystem path — like UPLOADS_DIR/AUDIT_DIR it defaults
# to data/backups/ under the repo root and isn't listed here; set it in a
# real .env only if you need backups written somewhere else.)
BACKUP_RETENTION_COUNT=7
PG_DUMP_CMD=pg_dump
PSQL_CMD=psql
